# ==============================================================================
# PayShield AI - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and restart `npm run dev`.
# .env.local is ignored by Git; never commit or log its contents.
# The local fixture tests need no credentials. Leave integration settings unset
# unless you intentionally enable that external integration.

# ── Optional PayPal invoice verification (Sandbox only) ───────────────────────

# PayPal Sandbox credentials (optional; invoices are marked unverified if omitted)
# 1. Go to https://developer.paypal.com/dashboard/applications/sandbox
# 2. Create an app (or select an existing one)
# 3. Copy the Client ID and Secret below
# PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
# PAYPAL_CLIENT_SECRET=replace_with_paypal_sandbox_client_secret

# Must be "sandbox". Live mode is rejected by the app.
PAYPAL_ENVIRONMENT=sandbox

# ── Optional ─────────────────────────────────────────────────────────────────

# Optional: OpenAI API key enables AI-powered analysis.
# Without it, analysis uses the deterministic rule engine.
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=replace_with_openai_api_key

# OpenAI model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# PayPal Webhook ID (required only for webhook signature verification)
# PayPal App page -> Add Webhook (needs a public HTTPS URL, e.g. ngrok) -> copy Webhook ID
# PAYPAL_WEBHOOK_ID=your_webhook_id_here

# Optional development-only secret for the webhook simulator header
# PAYSHIELD_DEV_SECRET=replace_with_a_random_development_secret

# SQLite database file path (default: ./data/payshield.db)
# DATABASE_PATH=./data/payshield.db

# ── Optional Gmail monitoring (not needed for local fixture tests) ───────────
# No personal Gmail account or OAuth setup is required to run the local fixtures.
# Enable Gmail only if you explicitly want to connect an account.
# Enable Gmail API and create a Web application OAuth client in Google Cloud.
# Local redirect URI: http://localhost:3000/api/gmail/callback
# Add this exact URI to the OAuth client's Authorized redirect URIs.
# Restrict the deployed app at the proxy so the dashboard and all /api/* routes
# are never publicly reachable without sign-in.
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Generate encryption key with 32 random bytes, base64-encoded. Generate the
# state and cron secrets independently with at least 32 random characters each.
# PAYSHIELD_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-random-key
# PAYSHIELD_OAUTH_STATE_SECRET=at-least-32-random-characters
# PAYSHIELD_CRON_SECRET=at-least-32-random-characters
# The scheduler sends Authorization: Bearer <PAYSHIELD_CRON_SECRET> to
# GET /api/cron/gmail every minute. Keep SQLite on persistent local storage.
